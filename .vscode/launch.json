{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": ["<node_internals>/**"],
            // Assicurati che la cartella di lavoro di partenza sia quella corretta
            "cwd": "${workspaceFolder}/scacchi", 
            "program": "${workspaceFolder}/scacchi/test/term.js",
            "console": "integratedTerminal",
            "restart": true,
            // Aiuta VS Code ad agganciarsi prima che il codice parta
            "stopOnEntry": false 
        }
    ]
}