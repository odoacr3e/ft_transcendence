DB_HOST=postgres
DB_NAME=chess
DB_USER=chess
DB_PWD=chess_local_dev
DB_PORT=5432
JWT_SECRET=local_dev_only_change_me
NODE_ENV=development
HASH_SALT=10
JWT_TTL=15m
REFRESH_TTL=7d
ALLOWED_URL=https://localhost:8000

GMAIL_USER=user
GMAIL_APP_PWD=pwd

GOOGLE_CLIENT_ID=id
