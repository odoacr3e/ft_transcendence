OTP_TTL=300
OTP_MAX_TRY=5

DATABASE_URL=postgresql://chess:chess_local_dev@postgres:5432/chess?schema=public

# "true" accende Vault, qualsiasi altro valore lo lascia spento
VAULT_ENABLED=false
