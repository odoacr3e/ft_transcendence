#!/bin/bash


PID_FRONTEND=""
pwdRoot="$(pwd)"
pwd="$(pwd)/Test"

first_set_up()
{
	git clone -b backend $backUrl backend || error "cannot get backend"
	git clone -b frontend $frontUrl frontend || error "cannot get frontend"
}

setupFrontend()
{
	cd frontend
	
	if [[ $1 == "run" ]];then
		npx vite --host 0.0.0.0 &
		PID_FRONTEND=$!
	else
		git pull || error "cannot pull frontend (try ncdu)!"
		npm install || error "frontend: npm failed"
		echo "frontend settato, Sai qual'e' la differenza tra un cattivo e un super cattivo?" 
	fi
}

setupBackend()
{
	cd backend
	
	if [[ $1 == "run" ]];then
		cd scacchi
		echo "run term..."
		node test/term.js 2> /dev/null
	else
		git pull || error "cannot pull backend"
		cd scacchi
		npm run make
		echo "Backend settato, che burro!"
	fi
}

pulizia_etnica()
{
	test "$PID_FRONTEND" != "" && kill "$PID_FRONTEND"
	echo "Addio."
	exit 0
}

error()
{
	echo $1
	exit 1
}

backUrl="git@github.com:odoacr3e/ft_transcendence.git"
frontUrl="git@github.com:odoacr3e/ft_transcendence.git"

#SECTION - main

#1) crea cartella Test
mkdir -p "Test" && cd ./Test || error "cannot init"

if [ ! -d "backend" ]; then
	if test "$USER" = "codespace";then
		gh repo clone odoacr3e/ft_transcendence backend -- --branch backend
	else
		git clone -b backend $backUrl backend || error "cannot get backend"
	fi
else
	echo "backend already exists!"
fi

if [ ! -d "frontend" ]; then
	if test "$USER" = "codespace";then
		gh repo clone odoacr3e/ft_transcendence frontend -- --branch frontend
	else
		git clone -b frontend $frontUrl frontend || error "cannot get frontend"
	fi
else
	echo "frontend already exists!"
fi

#2) prendi cartella
if [ ! -f ".env" ]; then
	touch .env
fi

#SIGNAL HANDLER
trap pulizia_etnica SIGINT

#3) setup frontend
cd "$pwd"
setupFrontend $1
#4) setup backend
cd "$pwd"
setupBackend $1

cd "$pwd"

if [[ $1 == "run" ]];then
	wait "$PID_FRONTEND"
else
	cd "$pwdRoot" || error "pwdRoot has been lost, wtf?"
	./play run
fi