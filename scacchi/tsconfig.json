{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@prisma/client": ["./generated/prisma"]
    },
    "checkJs": true,
    "allowJs": true
  },
  "include": ["prisma.config.ts"],
  "exclude": ["node_modules", "generated"]
}